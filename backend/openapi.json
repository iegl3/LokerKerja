{
  "openapi": "3.1.0",
  "info": {
    "title": "LokerKerja CV Intelligence API",
    "description": "\n## CV Intelligence & Safe Apply Kit\n\n**Tagline:** \"Verifikasi dulu, tailor cepat, kirim rapi—tanpa spam.\"\n\n### Features\n- **Smart CV Parsing**: PDF & Image support with OCR\n- **Multi-language**: English & Indonesian date parsing\n- **Duration Extraction**: Automatic work experience calculation\n- **ATS-Friendly**: Structured data for job applications\n- **Privacy-First**: PII masking and secure processing\n\n### Supported File Types\n- PDF (searchable and scanned)\n- Images: PNG, JPEG, WebP\n\n### Rate Limits\n- File size: 12MB max\n- Pages: 3 pages default (configurable)\n- Concurrent requests: Rate limited per provider\n\n### Authentication\nCurrently open API. JWT authentication coming soon.\n    ",
    "contact": {
      "name": "LokerKerja Team"
    },
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Development server"
    },
    {
      "description": "Production server (coming soon)"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Check if the API is running and healthy",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "API Information",
        "description": "Get basic API information and available endpoints",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/cv/parse": {
      "post": {
        "tags": [
          "CV Processing"
        ],
        "summary": "Parse CV Document",
        "description": "Upload and parse CV/resume from PDF or image file",
        "operationId": "parse_cv_api_cv_parse_post",
        "parameters": [
          {
            "name": "pages",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Page range to process (e.g., '1-3' or '1,3')",
              "title": "Pages"
            },
            "description": "Page range to process (e.g., '1-3' or '1,3')",
            "example": "1-3"
          },
          {
            "name": "force_ocr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Force OCR even for searchable PDFs",
              "default": false,
              "title": "Force Ocr"
            },
            "description": "Force OCR even for searchable PDFs"
          },
          {
            "name": "max_pages",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "description": "Maximum pages to process (1-10)",
              "default": 3,
              "title": "Max Pages"
            },
            "description": "Maximum pages to process (1-10)"
          },
          {
            "name": "scale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 4.0,
              "minimum": 1.0,
              "description": "Image scaling factor for OCR quality (1.0-4.0)",
              "default": 2.0,
              "title": "Scale"
            },
            "description": "Image scaling factor for OCR quality (1.0-4.0)"
          },
          {
            "name": "use_cache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Use cached results if available",
              "default": true,
              "title": "Use Cache"
            },
            "description": "Use cached results if available"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_cv_api_cv_parse_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CV successfully parsed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CVParseResponse"
                }
              }
            }
          },
          "413": {
            "description": "File too large (>12MB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported file type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Parsing failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_parse_cv_api_cv_parse_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "CV file (PDF, PNG, JPEG, WebP)"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_parse_cv_api_cv_parse_post"
      },
      "CVParseResponse": {
        "properties": {
          "req_id": {
            "type": "string",
            "title": "Req Id",
            "description": "Unique request identifier"
          },
          "profile": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CVProfile"
              }
            ],
            "description": "Parsed CV profile data"
          },
          "meta": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ParseMetadata"
              }
            ],
            "description": "Processing metadata"
          },
          "from_cache": {
            "type": "boolean",
            "title": "From Cache",
            "description": "Whether result was served from cache",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "req_id",
          "profile",
          "meta"
        ],
        "title": "CVParseResponse"
      },
      "CVProfile": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "description": "Profile schema version",
            "default": "1.0"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Data source",
            "default": "cv_upload"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Full name"
          },
          "contacts": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ContactInfo"
              }
            ],
            "description": "Contact information"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary",
            "description": "Professional summary"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills",
            "description": "Skills list"
          },
          "experience": {
            "items": {
              "$ref": "#/components/schemas/Experience"
            },
            "type": "array",
            "title": "Experience",
            "description": "Work experience"
          },
          "education": {
            "items": {
              "$ref": "#/components/schemas/Education"
            },
            "type": "array",
            "title": "Education",
            "description": "Education history"
          },
          "certs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Certs",
            "description": "Certifications"
          },
          "extras": {
            "type": "object",
            "title": "Extras",
            "description": "Additional data"
          },
          "total_duration_months": {
            "type": "integer",
            "title": "Total Duration Months",
            "description": "Total work experience in months",
            "default": 0
          },
          "total_duration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Duration",
            "description": "Human-readable total duration"
          },
          "features": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProfileFeatures"
              },
              {
                "type": "null"
              }
            ],
            "description": "Additional computed features"
          }
        },
        "type": "object",
        "title": "CVProfile"
      },
      "ContactInfo": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Email address"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "description": "Phone number"
          },
          "phone_masked": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone Masked",
            "description": "Masked phone number for privacy"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "Location/address"
          },
          "links": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Links",
            "description": "Social media/portfolio links"
          }
        },
        "type": "object",
        "title": "ContactInfo"
      },
      "Education": {
        "properties": {
          "degree": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degree",
            "description": "Degree/certification name"
          },
          "school": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "School",
            "description": "Institution name"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start",
            "description": "Start date (YYYY-MM format)"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "End date (YYYY-MM format)"
          }
        },
        "type": "object",
        "title": "Education"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Error message"
          },
          "req_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Req Id",
            "description": "Request ID for debugging"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "Experience": {
        "properties": {
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company",
            "description": "Company name"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role",
            "description": "Job title/role"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start",
            "description": "Start date (YYYY-MM format)"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "End date (YYYY-MM format)"
          },
          "duration_months": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Months",
            "description": "Duration in months"
          },
          "bullets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Bullets",
            "description": "Job responsibilities/achievements"
          }
        },
        "type": "object",
        "title": "Experience"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "description": "Health status"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "HealthResponse"
      },
      "ParseMetadata": {
        "properties": {
          "ocr_ms": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Ms",
            "description": "OCR processing time"
          },
          "parse_ms": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parse Ms",
            "description": "LLM parsing time"
          },
          "fix_ms": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix Ms",
            "description": "JSON repair time"
          },
          "total_ms": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Ms",
            "description": "Total processing time"
          },
          "parse_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parse Model",
            "description": "LLM model used for parsing"
          },
          "fix_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix Model",
            "description": "LLM model used for repair"
          },
          "ocr_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Model",
            "description": "OCR model used"
          }
        },
        "type": "object",
        "title": "ParseMetadata"
      },
      "ProfileFeatures": {
        "properties": {
          "skills_norm": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills Norm",
            "description": "Normalized skills list"
          },
          "years_total": {
            "type": "number",
            "title": "Years Total",
            "description": "Total years of experience",
            "default": 0.0
          },
          "latest_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Role",
            "description": "Most recent job title"
          },
          "latest_company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Company",
            "description": "Most recent company"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "description": "Parsing confidence score (0-1)",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "ProfileFeatures"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "System",
      "description": "System health and information endpoints"
    },
    {
      "name": "CV Processing",
      "description": "CV parsing and analysis endpoints"
    }
  ]
}