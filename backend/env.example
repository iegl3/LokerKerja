# LokerKerja Environment Configuration

# === AI & CV Processing ===
# Lunos API (LLM operations)
LUNOS_API_KEY=your_lunos_api_key_here
LUNOS_BASE_URL=https://api.lunos.tech/v1

# UNLI Vision API (OCR)
UNLI_API_KEY=your_unli_api_key_here  
UNLI_BASE_URL=https://api.unli.xyz

# === Email Service (Mailry) ===
# Required for sending job alerts and results
MAILRY_API_KEY=your_mailry_api_key_here
MAILRY_BASE_URL=https://api.mailry.co/ext
MAILRY_SENDER_EMAIL_ID=your_sender_email_id_from_mailry
MAILRY_WEBHOOK_SECRET=your_webhook_secret_for_verification

# === Database ===
# SQLite database path (will be created automatically)
DATABASE_PATH=data/subscriptions.db

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=data/app.log

# === API Configuration ===
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true 