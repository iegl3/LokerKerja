# LokerKerja Environment Configuration

# === AI & CV Processing ===
# 9router is OpenAI-compatible. Prefer AI_* names for new deployments.
AI_PROVIDER=9router
AI_API_KEY=replace_me
AI_BASE_URL=https://api.9router.com/v1
AI_APP_ID=lokerkerja-backend
AI_TEXT_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Legacy fallback names still supported by old module imports.
# LUNOS_API_KEY=
# UNLI_API_KEY=

# === Email Service ===
# Small production default: SMTP provider (Brevo, Resend SMTP, Mailgun SMTP, SES SMTP, etc.)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=LokerKerja
SMTP_USE_TLS=true

# Legacy Mailry fallback. Leave blank unless still using Mailry.
# MAILRY_API_KEY=
# MAILRY_BASE_URL=https://api.mailry.co/ext
# MAILRY_SENDER_EMAIL_ID=
# MAILRY_WEBHOOK_SECRET=

# === Database ===
DATABASE_PATH=data/subscriptions.db

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=data/app.log

# === API Configuration ===
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://lokerkerja.my.id,https://www.lokerkerja.my.id
